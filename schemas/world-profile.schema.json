{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muse-mobilize.local/schemas/world-profile.schema.json",
  "title": "Muse Mobilize World Profile",
  "description": "Structured atlas metadata stored on a non-character canon entity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["categories", "attributes", "canvas", "images"],
  "properties": {
    "categories": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["era", "atmosphere", "significance"],
      "properties": {
        "era": { "type": "string" },
        "atmosphere": { "type": "string" },
        "significance": { "type": "string" }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": -100000, "maximum": 100000 },
        "y": { "type": "number", "minimum": -100000, "maximum": 100000 }
      }
    },
    "images": {
      "type": "array",
      "items": { "$ref": "#/$defs/image" }
    },
    "referenceDocumentId": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "src", "caption", "tags"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "src": { "type": "string", "minLength": 1 },
        "caption": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
