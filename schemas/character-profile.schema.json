{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muse-mobilize.local/schemas/character-profile.schema.json",
  "title": "Muse-Mobilize Character Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["categories", "attributes", "physical", "senses", "references"],
  "properties": {
    "categories": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "pronouns", "age", "goals", "fears"],
      "properties": {
        "role": { "type": "string" },
        "pronouns": { "type": "string" },
        "age": { "type": "string" },
        "goals": { "$ref": "#/$defs/stringList" },
        "fears": { "$ref": "#/$defs/stringList" }
      }
    },
    "physical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "distinguishingFeatures", "clothing"],
      "properties": {
        "description": { "type": "string" },
        "distinguishingFeatures": { "$ref": "#/$defs/stringList" },
        "clothing": { "$ref": "#/$defs/stringList" }
      }
    },
    "senses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vision", "audio", "proximity"],
      "properties": {
        "vision": { "$ref": "#/$defs/sense" },
        "audio": { "$ref": "#/$defs/sense" },
        "proximity": { "$ref": "#/$defs/sense" }
      }
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["images"],
      "properties": {
        "images": {
          "type": "array",
          "items": { "$ref": "#/$defs/image" }
        }
      }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "status": {
      "enum": ["idea", "proposed", "established", "canonical", "retconned", "deprecated"]
    },
    "subtag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "value", "indicator", "status", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "string" },
        "indicator": {
          "enum": ["strength", "limitation", "sensitivity", "preference", "neutral"]
        },
        "status": { "$ref": "#/$defs/status" },
        "evidence": { "$ref": "#/$defs/stringList" }
      }
    },
    "sense": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "subtags"],
      "properties": {
        "summary": { "type": "string" },
        "subtags": {
          "type": "array",
          "items": { "$ref": "#/$defs/subtag" }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "src", "caption", "tags"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "src": { "type": "string", "minLength": 1 },
        "caption": { "type": "string" },
        "tags": { "$ref": "#/$defs/stringList" }
      }
    }
  }
}
